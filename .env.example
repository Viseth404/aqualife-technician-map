# Copy this file to ".env" and fill in your keys.
# The map itself needs NO key (it uses free OpenStreetMap services).

# Supabase project (Project Settings > API) – shares data between all admins.
# Leave empty to run in "demo mode" (data saved only in this browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
